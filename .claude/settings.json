{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(npm test)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build)",
      "PowerShell(npm run smoke)",
      "PowerShell(npm audit)",
      "PowerShell(npx vitest run *)",
      "PowerShell(npx biome check *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git worktree list)"
    ],
    "ask": [
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(npm run firebase:deploy)"
    ],
    "deny": [
      "PowerShell(firebase deploy *)",
      "PowerShell(git push *)",
      "PowerShell(git add -A *)",
      "PowerShell(git add --all *)",
      "PowerShell(git add .)"
    ]
  }
}
